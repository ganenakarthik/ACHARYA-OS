{
  "name": "agentic-ai-mentor",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "prestart": "powershell -NoProfile -Command \"try { Get-NetTCPConnection -LocalPort 5174 -ErrorAction Stop | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue } } catch {}; exit 0\"",
    "start": "electron .",
    "dev": "concurrently -k \"vite --port 5174 --host 127.0.0.1\" \"wait-on -t 30000 tcp:127.0.0.1:5174 && electron .\"",
    "electron:dev": "concurrently -k \"vite --port 5174 --host 127.0.0.1\" \"wait-on -t 30000 tcp:127.0.0.1:5174 && electron .\"",
    "electron": "electron .",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "follow-redirects": "^1.16.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "wav": "^1.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "description": "Autonomous AI-powered learning mentor"
}
